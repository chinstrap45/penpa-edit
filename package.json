{
  "name": "penpa-tests",
  "scripts": {
    "test": "node --test --test-concurrency=4 --test-timeout=60000 \"test/**/*.test.mjs\"",
    "test:live": "node live/run-live.mjs",
    "test:live:changed": "node live/run-live.mjs --base origin/master",
    "fuzz:ui": "node live/ui-fuzz/run.mjs",
    "fuzz:ui:nightly": "node live/ui-fuzz/nightly.mjs",
    "measure": "node live/measure.mjs",
    "recordings:approve": "node live/approve-recordings.mjs",
    "test:browser": "nodemon --watch test/test_server.js test/test_server.js",
    "local": "npx browser-sync start --server",
    "lint": "node live/lint.mjs"
  },
  "standard": {
    "envs": [
      "browser"
    ],
    "globals": [
      "$",
      "Color",
      "DOMPurify",
      "GALLERY_PUZZLES",
      "MULTICOLOR_REMAP",
      "PenpaIO",
      "PenpaProgress",
      "PenpaText",
      "Puzzle",
      "Stack",
      "Swal",
      "THEME_DARK",
      "THEME_LIGHT",
      "TOOL_CALLS",
      "UserSettings",
      "axe",
      "create_newboard",
      "decrypt_data",
      "encrypt_data",
      "engine",
      "errorMsg",
      "getCookie",
      "setCookie",
      "import_url",
      "localforage",
      "make_class",
      "md5",
      "load",
      "mode_names",
      "newBoard",
      "penpa_modes",
      "penpa_tags",
      "pu",
      "readEngineState",
      "redraw_grid",
      "saveProgressNow",
      "savetext_clone",
      "set_circle_style",
      "set_font_style",
      "set_genre_tags",
      "set_line_style",
      "set_surface_style",
      "sw_timer",
      "toolGuide",
      "update_textarea",
      "update_title",
      "withPenpaMark",
      "withoutPenpaMark"
    ]
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "browser-sync": "^2.29.3",
    "chai": "^4.5.0",
    "express": "^4.21.2",
    "fast-check": "^4.10.2",
    "mocha": "^10.8.2",
    "nodemon": "^2.0.22",
    "playwright": "^1.64.1",
    "standard": "^17.1.2"
  }
}
